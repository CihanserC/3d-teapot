{
  "name": "aurelia-teapot-atelier",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-realistic interactive 3D teapot atelier built with Three.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/app.js --minify --target=es2020 && esbuild src/styles.css --bundle --loader:.woff2=dataurl --outfile=dist/app.css --minify",
    "dev": "esbuild src/main.js --bundle --format=iife --outfile=dist/app.js --sourcemap --target=es2020 --watch"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "^25.17.0"
  }
}
